// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL") // z.B. "file:./dev.db"
}

model User {
  id             Int             @id @default(autoincrement())
  email          String          @unique
  passwordHash   String
  accounts       Account[]
  socialAccounts SocialAccount[]
  projects       Project[]
  posts          Post[]
  createdAt      DateTime        @default(now())
}

model Account {
  id       Int    @id @default(autoincrement())
  handle   String @unique
  platform String
  userId   Int
  user     User   @relation(fields: [userId], references: [id])

  // ⚠️ WICHTIG: gleicher Relation-Name wie in Post.accounts
  posts Post[] @relation("PostAccounts")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SocialAccount {
  id        String @id @default(cuid())
  platform  String
  username  String
  status    String @default("ACTIVE")
  userId    Int
  user      User   @relation(fields: [userId], references: [id])
  posts     Post[] @relation("SocialAccountPosts")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, platform, username])
}

model Project {
  id        Int      @id @default(autoincrement())
  name      String
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  posts     Post[]
  createdAt DateTime @default(now())
}

model Post {
  id          String   @id @default(cuid())
  content     String
  mediaUrl    String?
  status      String   @default("SCHEDULED")
  scheduledAt DateTime?
  postedAt    DateTime?
  userId      Int
  user        User     @relation(fields: [userId], references: [id])

  // Legacy relations
  projectId Int?
  project   Project? @relation(fields: [projectId], references: [id])
  accounts  Account[] @relation("PostAccounts")

  // New social account relation
  accountId String?
  account   SocialAccount? @relation("SocialAccountPosts", fields: [accountId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}