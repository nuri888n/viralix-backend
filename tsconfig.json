{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "src",
    "outDir": "./dist",
    "resolveJsonModule": true,
    "typeRoots": ["./node_modules/@types"]
  },
  "include": [
    "src/index.ts",
    "src/db.ts",
    "src/hello.ts",
    "src/worker.ts",
    "src/middleware/*.ts",
    "src/routes/*.ts",
    "src/types/*.ts"
  ]
}
